generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CRM_MANAGER
  SALES
  SUPPORT
  ENGINEER
  CUSTOMER
}

enum AuthEvent {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  TOKEN_REFRESH
  PASSWORD_CHANGED
  SESSION_REVOKED
  UNAUTHORIZED_ACCESS
  // CRM Events
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_STATUS_CHANGED
  LEAD_ASSIGNED
  LEAD_CONVERTED
  LEAD_NOTE_ADDED
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  DEVICE_ADDED
  DEVICE_UPDATED
  CUSTOMER_NOTE_ADDED
  // Repair Events
  REPAIR_CREATED
  REPAIR_ASSIGNED
  REPAIR_DIAGNOSED
  REPAIR_ESTIMATE_APPROVED
  REPAIR_ESTIMATE_REJECTED
  REPAIR_STATUS_CHANGED
  REPAIR_QC_PASSED
  REPAIR_DELIVERED
  REPAIR_CLOSED
  REPAIR_NOTE_ADDED
}

enum LeadType {
  GENERAL_INQUIRY
  QUOTE_REQUEST
  REPAIR_REQUEST
  BUSINESS_CONSULTATION
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CONVERTED
  LOST
}

enum LeadSource {
  WEBSITE
  PHONE
  EMAIL
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  GOOGLE_ADS
  ORGANIC
  REFERRAL
  MANUAL
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InquiryCategory {
  SALES
  SUPPORT
  REPAIR
  CORPORATE
  BILLING
  OTHER
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  IN_REPAIR
  REPAIRED
  RETURNED
}

enum DeviceCategory {
  SMARTPHONE
  TABLET
  LAPTOP
  DESKTOP
  SMARTWATCH
  ACCESSORY
  OTHER
}

enum RepairStatus {
  NEW
  INSPECTING
  DIAGNOSING
  WAITING_APPROVAL
  APPROVED
  WAITING_PARTS
  IN_REPAIR
  ON_HOLD
  QUALITY_CHECK
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
  CLOSED
}

enum RepairPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InventoryMovementType {
  IN
  OUT
  RESERVE
  RELEASE
  CONSUME
  ADJUSTMENT
  TRANSFER
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum InventoryItemStatus {
  ACTIVE
  DISCONTINUED
  OUT_OF_SERVICE
}

enum Unit {
  PIECE
  SET
  PACK
  BOX
  ROLL
  METER
}

enum InventoryMovementReason {
  PURCHASE
  REPAIR
  ADJUSTMENT
  RETURN
  TRANSFER
  INITIAL_STOCK
  MANUAL
}

enum InvoiceStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum InvoiceItemType {
  LABOR
  PART
  SERVICE
  ADJUSTMENT
  DISCOUNT
}

enum Currency {
  BDT
  USD
}

enum SourceType {
  INVENTORY
  LABOR
  SERVICE
  MANUAL
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           Role           @default(CUSTOMER)
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  isActive       Boolean        @default(true)
  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  permissions    Permission[]   @relation("UserPermissions")
  activities     ActivityLog[]
  tasks          Task[]         @relation("AssignedTasks")
  sessions       Session[]
  refreshTokens  RefreshToken[]
  loginHistories LoginHistory[]
  auditLogs      AuditLog[]
  leads          Lead[]         @relation("AssignedLeads")
  leadActivities LeadActivity[]
  leadNotes      LeadNote[]
  customerActivities CustomerActivity[]
  customerNotes      CustomerNote[]
  assignedRepairs    RepairOrder[]  @relation("AssignedRepairs")
  repairActivities   RepairActivity[]
  repairNotes        RepairNote[]
  receivedRepairs    RepairOrder[]  @relation("ReceivedRepairs")

  // Inventory Integration
  inventoryMovements InventoryMovement[]
  inventoryAdjustments InventoryAdjustment[] @relation("AdjustmentApprover")
  createdAdjustments   InventoryAdjustment[] @relation("AdjustmentCreator")

  // Invoice Integration
  createdInvoices      Invoice[]             @relation("InvoiceCreator")
  approvedInvoices     Invoice[]             @relation("InvoiceApprover")
  invoiceNotes         InvoiceNote[]
  invoiceActivities    InvoiceActivity[]
  invoiceStatusHistory InvoiceStatusHistory[]
}

model Permission {
  id          String   @id @default(uuid())
  action      String   // e.g., 'CREATE', 'READ', 'UPDATE', 'DELETE'
  resource    String   // e.g., 'users', 'projects'
  description String?
  users       User[]   @relation("UserPermissions")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Organization {
  id          String     @id @default(uuid())
  name        String
  domain      String?    @unique
  industry    String?
  customers   Customer[]
  users       User[]
  projects    Project[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Customer {
  id             String       @id @default(uuid())
  customerNumber String       @unique // FBXC-000001
  type           CustomerType @default(INDIVIDUAL)
  firstName      String
  lastName       String
  company        String?
  email          String?      @unique
  phone          String?
  alternatePhone String?
  address        String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  notes          String?
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  leads          Lead[]
  tickets        Ticket[]
  devices        Device[]
  activities     CustomerActivity[]
  customerNotes  CustomerNote[]
  repairs        RepairOrder[]
  invoices       Invoice[]

  @@index([email])
  @@index([phone])
  @@index([createdAt])
}

model Lead {
  id              String         @id @default(uuid())
  referenceNumber String         @unique // FBX-YYYY-000001
  type            LeadType
  priority        LeadPriority   @default(NORMAL)
  category        InquiryCategory @default(OTHER)
  
  firstName       String
  lastName        String
  company         String?
  phone           String
  email           String
  
  deviceType      String?
  serviceRequested String?
  message         String?
  
  source          LeadSource     @default(WEBSITE)
  status          LeadStatus     @default(NEW)
  
  consentAccepted   Boolean   @default(false)
  consentAcceptedAt DateTime?

  // Marketing Attribution
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  landingPage     String?
  referrer        String?
  
  assignedTo      String?
  assignee        User?          @relation("AssignedLeads", fields: [assignedTo], references: [id], onDelete: SetNull)
  
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  activities      LeadActivity[]
  notes           LeadNote[]
  repairs         RepairOrder[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
}

model Project {
  id             String       @id @default(uuid())
  name           String
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  status         String
  tasks          Task[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  assigneeId  String?
  assignee    User?    @relation("AssignedTasks", fields: [assigneeId], references: [id])
  status      String
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Ticket {
  id          String   @id @default(uuid())
  title       String
  description String
  status      String
  priority    String
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Department {
  id          String   @id @default(uuid())
  name        String
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  details   String?
  createdAt DateTime @default(now())
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  deviceName   String?
  lastActivity DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  isRevoked    Boolean  @default(false)
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  isRevoked   Boolean  @default(false)
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  status    String   // "SUCCESS" or "FAILED"
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String    @id @default(uuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  event     AuthEvent
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime  @default(now())
}

model Sequence {
  id    String @id
  value Int    @default(0)
}

model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([userId])
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([userId])
}

model Device {
  id             String         @id @default(uuid())
  deviceNumber   String         @unique // FBXD-000001
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id])
  brand          String
  model          String
  category       DeviceCategory
  serialNumber   String?
  imei           String?
  color          String?
  purchaseDate   DateTime?
  warrantyExpiry DateTime?
  condition      String?
  notes          String?
  status         DeviceStatus   @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  repairs        RepairOrder[]

  @@index([customerId])
  @@index([imei])
  @@index([serialNumber])
}

model CustomerActivity {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([userId])
  @@index([createdAt])
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  note       String
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([userId])
}

model RepairOrder {
  id                      String        @id @default(uuid())
  repairNumber            String        @unique // FBXR-000001
  customerId              String
  customer                Customer      @relation(fields: [customerId], references: [id])
  deviceId                String
  device                  Device        @relation(fields: [deviceId], references: [id])
  leadId                  String?
  lead                    Lead?         @relation(fields: [leadId], references: [id])
  
  assignedTechnicianId    String?
  assignedTechnician      User?         @relation("AssignedRepairs", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  receivedByUserId        String?
  receivedByUser          User?         @relation("ReceivedRepairs", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  
  status                  RepairStatus  @default(NEW)
  priority                RepairPriority @default(NORMAL)
  
  problemDescription      String
  customerComplaint       String?
  intakeCondition         String?
  accessoriesReceived     String?
  
  estimatedCost           Float?
  approvedCost            Float?
  partsCost               Float?
  finalCost               Float?
  
  estimatedCompletionDate DateTime?
  completedAt             DateTime?
  deliveredAt             DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  activities              RepairActivity[]
  notes                   RepairNote[]
  diagnosis               Diagnosis?
  statusHistory           RepairStatusHistory[]
  checklist               RepairChecklistItem[]
  
  // Inventory Integration
  reservations            InventoryReservation[]
  inventoryMovements      InventoryMovement[]

  // Billing Integration
  invoices                Invoice[]

  @@index([customerId])
  @@index([deviceId])
  @@index([status])
  @@index([priority])
  @@index([assignedTechnicianId])
  @@index([createdAt])
}

model RepairActivity {
  id            String       @id @default(uuid())
  repairOrderId String
  repairOrder   RepairOrder  @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String
  details       String?
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([repairOrderId])
  @@index([userId])
}

model RepairNote {
  id            String       @id @default(uuid())
  repairOrderId String
  repairOrder   RepairOrder  @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  content       String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([repairOrderId])
  @@index([userId])
}

model Diagnosis {
  id               String       @id @default(uuid())
  repairOrderId    String       @unique
  repairOrder      RepairOrder  @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  issueFound       String?
  rootCause        String?
  technicianNotes  String?
  repairability    String?      // e.g. "Fixable", "Not Fixable", "Requires Board Replacement"
  recommendedParts String?
  estimatedTime    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model ChecklistTemplate {
  id            String   @id @default(uuid())
  name          String
  items         Json     // Array of string tasks
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RepairChecklistItem {
  id            String       @id @default(uuid())
  repairOrderId String
  repairOrder   RepairOrder  @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  task          String
  isCompleted   Boolean      @default(false)
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([repairOrderId])
}

model RepairStatusHistory {
  id            String       @id @default(uuid())
  repairOrderId String
  repairOrder   RepairOrder  @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  status        RepairStatus
  notes         String?
  createdAt     DateTime     @default(now())

  @@index([repairOrderId])
  @@index([createdAt])
}

// ==============================================================================
// INVENTORY & PARTS MANAGEMENT
// ==============================================================================

model Supplier {
  id          String   @id @default(uuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Reserved for Purchase Module
}

model InventoryCategory {
  id          String              @id @default(uuid())
  name        String              @unique
  description String?
  parentId    String?
  parent      InventoryCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    InventoryCategory[] @relation("CategoryHierarchy")
  
  items       InventoryItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([parentId])
}

model InventoryItem {
  id             String              @id @default(uuid())
  partNumber     String              @unique
  sku            String              @unique
  barcode        String?             @unique
  name           String
  description    String?
  
  categoryId     String
  category       InventoryCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  
  defaultCost    Float               @default(0)
  defaultPrice   Float               @default(0)
  
  minimumStock   Int                 @default(0)
  reorderLevel   Int                 @default(0)
  
  currentStock   Int                 @default(0)
  reservedStock  Int                 @default(0)
  
  unit           Unit                @default(PIECE)
  brand          String?
  manufacturer   String?
  
  status         InventoryItemStatus @default(ACTIVE)
  
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  
  movements      InventoryMovement[]
  reservations   InventoryReservation[]
  adjustments    InventoryAdjustment[]

  @@index([partNumber])
  @@index([sku])
  @@index([barcode])
  @@index([name])
  @@index([categoryId])
}

model StockLocation {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InventoryMovement {
  id               String                  @id @default(uuid())
  inventoryItemId  String
  item             InventoryItem           @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  
  repairOrderId    String?
  repairOrder      RepairOrder?            @relation(fields: [repairOrderId], references: [id], onDelete: SetNull)
  
  reservationId    String?                 // Nullable reference to a reservation
  adjustmentId     String?                 // Nullable reference to an adjustment
  
  quantity         Int
  previousStock    Int
  newStock         Int
  
  movementType     InventoryMovementType
  reason           InventoryMovementReason
  notes            String?
  
  createdById      String?
  createdBy        User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  
  createdAt        DateTime                @default(now())
  
  @@index([inventoryItemId])
  @@index([repairOrderId])
  @@index([createdAt])
}

model InventoryReservation {
  id                String            @id @default(uuid())
  repairOrderId     String
  repairOrder       RepairOrder       @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  
  inventoryItemId   String
  item              InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  
  quantity          Int
  status            ReservationStatus @default(ACTIVE)
  
  unitCostSnapshot  Float             @default(0)
  unitPriceSnapshot Float             @default(0)
  
  reservedAt        DateTime          @default(now())
  releasedAt        DateTime?
  consumedAt        DateTime?
  
  @@unique([repairOrderId, inventoryItemId, status], name: "active_reservation_unique") // Helps Option B: merging logic
  @@index([repairOrderId])
  @@index([inventoryItemId])
}

model InventoryAdjustment {
  id               String          @id @default(uuid())
  inventoryItemId  String
  item             InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  
  oldQuantity      Int
  newQuantity      Int
  reason           String
  
  approvedById     String?
  approvedBy       User?           @relation("AdjustmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  
  createdById      String?
  createdBy        User?           @relation("AdjustmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  
  createdAt        DateTime        @default(now())
  
  @@index([inventoryItemId])
}

// ==============================================================================
// BILLING & INVOICE MANAGEMENT
// ==============================================================================

model Invoice {
  id             String          @id @default(uuid())
  invoiceNumber  String          @unique // FBXI-000001
  
  repairOrderId  String
  repairOrder    RepairOrder     @relation(fields: [repairOrderId], references: [id], onDelete: Restrict)
  
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  status         InvoiceStatus   @default(DRAFT)
  currency       Currency        @default(USD)
  
  issueDate      DateTime?
  dueDate        DateTime?
  
  // Financial Totals (Calculated in Service)
  subtotal       Float           @default(0)
  laborTotal     Float           @default(0)
  partsTotal     Float           @default(0)
  discountTotal  Float           @default(0)
  taxTotal       Float           @default(0)
  grandTotal     Float           @default(0)
  
  // Payment Tracking
  paidAmount     Float           @default(0)
  balanceDue     Float           @default(0)
  
  notes          String?
  
  createdById    String?
  createdBy      User?           @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  
  approvedById   String?
  approvedBy     User?           @relation("InvoiceApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  
  items          InvoiceItem[]
  invoiceNotes   InvoiceNote[]
  statusHistory  InvoiceStatusHistory[]
  activities     InvoiceActivity[]
  
  @@index([invoiceNumber])
  @@index([customerId])
  @@index([repairOrderId])
  @@index([status])
  @@index([issueDate])
}

model InvoiceItem {
  id                 String          @id @default(uuid())
  invoiceId          String
  invoice            Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  type               InvoiceItemType
  
  // Source Traceability
  sourceType         SourceType
  sourceId           String?         // Nullable reference ID (e.g., InventoryReservation ID, Labor task ID)
  
  description        String
  quantity           Int             @default(1)
  unitPrice          Float           @default(0)
  
  // Snapshots for Immutability
  partNumberSnapshot String?
  skuSnapshot        String?
  itemNameSnapshot   String?
  unitSnapshot       String?         // Using string to capture unit at the time of invoicing
  
  // Tax & Discount Support
  discountAmount     Float           @default(0)
  taxAmount          Float           @default(0)
  
  lineTotal          Float           @default(0)
  
  displayOrder       Int             @default(0)
  
  @@index([invoiceId])
}

model InvoiceNote {
  id         String   @id @default(uuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  content    String
  createdAt  DateTime @default(now())
  
  @@index([invoiceId])
  @@index([userId])
}

model InvoiceStatusHistory {
  id         String        @id @default(uuid())
  invoiceId  String
  invoice    Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  status     InvoiceStatus
  notes      String?
  userId     String?
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  
  @@index([invoiceId])
  @@index([createdAt])
}

model InvoiceActivity {
  id         String   @id @default(uuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
