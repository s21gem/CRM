# GEMINI_API_KEY: Required for Gemini AI API calls.
# This environment variable is injected automatically at runtime in production.
# Configure this via your deployment environment's Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# This environment variable is injected automatically at runtime.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Deployment scripts (deployToVPS.ts, fixVPS.ts, uploadAssets.ts)
VPS_HOST=your-server-ip
VPS_USER=deploy
VPS_PASSWORD=your-ssh-password
